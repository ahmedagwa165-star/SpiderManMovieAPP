@model IEnumerable<SpiderManMoviesApp.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="container mt-4">
    <h1>Movies</h1>
    
    <div class="row text-muted fw-bold mt-4 mb-2">
        <div class="col-1">Id</div>
        <div class="col-3">Title</div>
        <div class="col-3">Director</div>
        <div class="col-2">Release Year</div>
        <div class="col-2">Details</div>
    </div>
    <hr />

    @foreach (var movie in Model)
    {
        <div class="row mb-2 align-items-center">
            <div class="col-1">@movie.Id</div>
            <div class="col-3">@movie.Title</div>
            <div class="col-3">@movie.Director</div>
            <div class="col-2">@movie.ReleaseYear</div>
            <div class="col-2">
                <a asp-action="Details" asp-route-id="@movie.Id">Details</a>
            </div>
        </div>
    }
</div>